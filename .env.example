# ---- Backend (copy to backend/.env or .env in the repo root) ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_supported_gemini_model   # default if unset: gemini-3.5-flash. gemini-2.5-flash was
                                           # scheduled for retirement on 2026-10-16; check
                                           # ai.google.dev/gemini-api/docs/deprecations
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=1
# DATABASE_URL=sqlite:///./leadiq.db
# CORS_ORIGINS=http://localhost:3000
# Optional scoring overrides (no code change needed)
# HOT_THRESHOLD=75
# WARM_THRESHOLD=50
# SCORING_CONFIG_PATH=./scoring_config.json

# ---- Frontend (frontend/.env.local) — contains NO secrets ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
