# ---- Backend (copy to backend/.env or .env in the repo root) ----
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash              # default if unset. Gemini 3.x models no longer use the
                                           # temperature / top_p / top_k parameters, so none are sent.
                                           # Model status: ai.google.dev/gemini-api/docs/deprecations
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=1
# DATABASE_URL=sqlite:///./leadiq.db
# CORS_ORIGINS=http://localhost:3000
# Optional scoring overrides (no code change needed)
# HOT_THRESHOLD=75
# WARM_THRESHOLD=50
# SCORING_CONFIG_PATH=./scoring_config.json
# (JSON key negative_intent_max_classification = HOT | WARM | COLD, default WARM: highest class a lead
#  with explicit negative purchase intent can receive; HOT disables the safeguard)

# ---- Frontend (frontend/.env.local) — contains NO secrets ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
